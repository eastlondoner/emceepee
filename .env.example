# emceepee-http environment variables.
# Copy to .env and adjust as needed.

# Port for emceepee-http. Default: 8080.
PORT=8080

# Interface to bind to. Default: 127.0.0.1 (loopback-only, recommended).
# emceepee-http has NO frontend authentication — do not expose it on a
# public interface unless you have placed it behind a trusted reverse proxy.
EMCEEPEE_HOST=127.0.0.1

# Public base URL used to build the OAuth redirect_uri and /connect links.
# Default: http://localhost:${PORT}.
EMCEEPEE_BASE_URL=http://localhost:8080

# Path to the persistent OAuth Dynamic Client Registration (RFC 7591) store.
# Registrations are keyed by authorization-server issuer URL. The file is
# written atomically with mode 0600.
# Default: ~/.emceepee/dcr-clients.json.
EMCEEPEE_DCR_STORE_PATH=~/.emceepee/dcr-clients.json

# Optional directory for structured JSON logs (stdio mode).
# EMCEEPEE_LOG_DIR=~/.emceepee/logs

# stdio mode: placeholder redirect_uri port for the session-manager's
# internal OAuth provider. The actual loopback callback listener started
# per-flow uses a random kernel-assigned port. You should only need to
# change this if something else on your machine happens to be bound to
# the default.
# EMCEEPEE_STDIO_OAUTH_PORT=14500
